{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Heritage film storyboard",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "language", "style_prompt", "character_prompt", "narration_style", "music", "shots"],
  "properties": {
    "title": {"$ref": "#/$defs/text"},
    "language": {"enum": ["en", "am"]},
    "style_prompt": {"$ref": "#/$defs/text"},
    "character_prompt": {"$ref": "#/$defs/text"},
    "character_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt", "seeds", "continuity_prompt"],
      "properties": {
        "prompt": {"$ref": "#/$defs/text"},
        "continuity_prompt": {"$ref": "#/$defs/text"},
        "seeds": {
          "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0}
        }
      }
    },
    "narration_style": {"$ref": "#/$defs/text"},
    "music": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caption", "instrumental", "bpm"],
      "properties": {
        "caption": {"$ref": "#/$defs/text"},
        "instrumental": {"type": "boolean"},
        "bpm": {"type": "integer", "minimum": 1},
        "seeds": {
          "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0}
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/shot"}
    }
  },
  "$defs": {
    "text": {"type": "string", "pattern": "\\S"},
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "duration_s", "reason", "shot_size", "image_prompt", "motion_prompt", "narration", "music_cue", "references", "seed"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "duration_s": {"type": "number", "exclusiveMinimum": 0},
        "reason": {"$ref": "#/$defs/text"},
        "shot_size": {"$ref": "#/$defs/text"},
        "image_prompt": {"$ref": "#/$defs/text"},
        "motion_prompt": {"$ref": "#/$defs/text"},
        "narration": {"$ref": "#/$defs/text"},
        "music_cue": {"$ref": "#/$defs/text"},
        "on_screen_text": {"$ref": "#/$defs/text"},
        "references": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/text"}
        },
        "seed": {"type": "integer", "minimum": 0}
      }
    }
  }
}
